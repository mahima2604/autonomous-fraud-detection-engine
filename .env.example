# Base URL for the backend API (Spring Boot).
# Point this at the real backend once it is available.
VITE_API_BASE_URL=http://localhost:8080/api

# When true, all service calls resolve against local mock data instead of
# hitting VITE_API_BASE_URL. Keep this true until the backend team has
# working endpoints to connect to.
VITE_USE_MOCKS=true
