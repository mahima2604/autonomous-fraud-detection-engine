# Base URL for the local FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Use the backend for auth, catalog, fraud assessment, and orders; payment remains simulated.
# Required for signing backend customer session tokens. Use a private random value.
AUTH_TOKEN_SECRET=replace-with-a-random-secret

# Optional demo administrator bootstrap. Keep disabled except for local development.
# Set APP_ENV=development and provide both ADMIN_EMAIL and ADMIN_PASSWORD before
# enabling ENABLE_DEMO_ADMIN. Never enable this bootstrap in production.
ENABLE_DEMO_ADMIN=false
# APP_ENV=development
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional CORS allowlist for local frontend origins (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fraud score policy: <= review is APPROVE, (review, block] is REVIEW, > block is BLOCK.
FRAUD_REVIEW_THRESHOLD=0.30
FRAUD_BLOCK_THRESHOLD=0.70
