# Base URL for the local FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Use the backend for auth, catalog, fraud assessment, and orders; payment remains simulated.
# Required for signing backend customer session tokens. Replace the blank value
# with a private random value; generate locally with Python's secrets module.
AUTH_TOKEN_SECRET=

# Optional demo administrator bootstrap. Keep disabled except for local development.
# Set APP_ENV=development and provide both ADMIN_EMAIL and ADMIN_PASSWORD before
# enabling ENABLE_DEMO_ADMIN. Never enable this bootstrap in production.
ENABLE_DEMO_ADMIN=false
# APP_ENV=development
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Optional CORS allowlist for local frontend origins (comma-separated).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fraud score policy: <= review is APPROVE, (review, block] is REVIEW, > block is BLOCK.
FRAUD_REVIEW_THRESHOLD=0.30
FRAUD_BLOCK_THRESHOLD=0.70
# Optional model selection. Defaults to GraphSAGE with no automatic fallback.
# FRAUD_PRIMARY_MODEL=gnn
# FRAUD_FALLBACK_MODEL=logistic_regression

# Email OTP is delivered through backend SMTP (STARTTLS on port 587 by default).
# Gmail is one possible no-cost sender; use an App Password, never your login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
